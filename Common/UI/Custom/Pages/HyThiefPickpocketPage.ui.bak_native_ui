$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@HintStyle = LabelStyle(
  FontSize: 15,
  VerticalAlignment: Center,
  HorizontalAlignment: Center,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  ShrinkTextToFit: true,
  MinShrinkTextToFitFontSize: 11
);

@SlotButtonStyle = (
  Default: (
    Background: "Pages/Inventory/Slot.png"
  ),
  Hovered: (
    Background: (TexturePath: "Pages/Inventory/Slot.png", Color: #ffffff(0.92))
  ),
  Pressed: (
    Background: (TexturePath: "Pages/Inventory/Slot.png", Color: #ffffff(0.82))
  ),
  Sounds: $Sounds.@ButtonsLight
);

@QuantityStyle = LabelStyle(
  FontSize: 13,
  TextColor: #ffffff,
  RenderBold: true,
  HorizontalAlignment: End,
  VerticalAlignment: End
);

