$C = "../Common.ui";
$C.@PageOverlay {
  LayoutMode: Middle;
  $C.@DecoratedContainer {
    Anchor: (Width: 600, Height: 490);
    #Title { $C.@Title { @Text = "HYTHIEF OWNERSHIP EDITOR"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);
      Label { Text: "Selected Container"; Style: (...$C.@DefaultLabelStyle); Anchor: (Height: 26); }
      Label #Selected { Text: ""; Style: (FontSize: 14, TextColor: #b4c8dc); Anchor: (Height: 42); }
      $C.@CheckBoxWithLabel #Owned { @Text = "Owned Container"; Anchor: (Height: 40); }
      Label { Text: "Ownership Scope"; Style: (...$C.@DefaultLabelStyle); Anchor: (Height: 28); }
      $C.@DropdownBox #Scope { }
      Label { Text: "Owning Faction"; Style: (...$C.@DefaultLabelStyle); Anchor: (Height: 36); Padding: (Top: 8); }
      $C.@DropdownBox #Faction { }
      Label #Status { Text: "Changes affect only this container. Escape cancels."; Style: (FontSize: 14, TextColor: #d9b879, Wrap: true); Anchor: (Height: 64); Padding: (Top: 10); }
      Group {
        LayoutMode: Left; Anchor: (Height: 44);
        $C.@TextButton #Apply { @Text = "Apply"; Anchor: (Width: 180, Right: 12); }
        $C.@SecondaryTextButton #Cancel { @Text = "Cancel"; Anchor: (Width: 180); }
      }
    }
  }
}
