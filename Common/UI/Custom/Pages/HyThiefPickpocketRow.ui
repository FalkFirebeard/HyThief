Button #Button {
  LayoutMode: Left;
  Padding: (Full: 6);
  Style: (
    Hovered: (
      Background: #000000(0.2),
    )
  );

  ItemIcon #Icon {
    Anchor: (Width: 32, Height: 32);
  }

  Label #Name {
    Padding: (Horizontal: 10, Vertical: 5);
    Style: (RenderBold: true);
    FlexWeight: 1;
  }

  Label #Quantity {
    Anchor: (Width: 80);
    Padding: (Vertical: 5);
    Style: (Alignment: Center, TextColor: #ffffff(0.8));
  }

  Group {
    LayoutMode: Full;
    Anchor: (Height: 2);
    Background: #ffffff(0.08);
  }
}
