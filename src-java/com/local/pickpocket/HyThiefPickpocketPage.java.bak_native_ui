package com.local.pickpocket;

import com.hypixel.hytale.component.Ref;
import com.hypixel.hytale.component.Store;
import com.hypixel.hytale.protocol.packets.interface_.CustomUIEventBindingType;
import com.hypixel.hytale.protocol.packets.interface_.CustomPageLifetime;
import com.hypixel.hytale.server.core.entity.entities.player.pages.CustomUIPage;
import com.hypixel.hytale.server.core.ui.builder.EventData;
import com.hypixel.hytale.server.core.ui.builder.UICommandBuilder;
import com.hypixel.hytale.server.core.ui.builder.UIEventBuilder;
import com.hypixel.hytale.server.core.universe.PlayerRef;
import com.hypixel.hytale.server.core.universe.world.storage.EntityStore;
import java.util.List;

public final class HyThiefPickpocketPage extends CustomUIPage {
  private static final int SLOT_COUNT = 9;
  private static final String UNKNOWN_ICON = "Pages/Inventory/UnknownItemIcon.png";
  private final MerchantStoragePage storagePage;

  public HyThiefPickpocketPage(MerchantStoragePage storagePage, PlayerRef playerRef) {
    super(playerRef, CustomPageLifetime.CanDismissOrCloseThroughInteraction);
    this.storagePage = storagePage;
  }

  @Override
  public void build(
      Ref<EntityStore> playerEntityRef,
      UICommandBuilder commands,
      UIEventBuilder events,
      Store<EntityStore> playerStore) {
    commands.append("Pages/HyThiefPickpocketPage.ui");
    commands.set("#Hint.Text", "Steal one slot at a time.");
    commands.set("#SubHint.Text", "Left click steals a stack. Right click steals one.");
    applyVisibleSlots(commands);
    bindSlotEvents(events);
  }

  @Override
  public void handleDataEvent(
      Ref<EntityStore> playerEntityRef, Store<EntityStore> playerStore, String data) {
    MerchantStoragePage.ClickResult result =
        storagePage.handleCustomSlotClick(playerEntityRef, playerStore, data);
    if (result == MerchantStoragePage.ClickResult.DETECTED) {
      close();
      return;
    }
    if (result == MerchantStoragePage.ClickResult.STOLEN) {
      rebuild();
    }
  }

  @Override
  public void onDismiss(Ref<EntityStore> playerEntityRef, Store<EntityStore> playerStore) {
    storagePage.saveItems();
  }

  private void applyVisibleSlots(UICommandBuilder commands) {
    List<VisibleEntry> entries = buildVisibleEntries();
    for (int i = 0; i < SLOT_COUNT; i++) {
      String slotPath = "#Slot" + i;
      if (i >= entries.size()) {
        commands.set(slotPath + ".Visible", false);
        continue;
      }

      VisibleEntry entry = entries.get(i);
      commands.set(slotPath + ".Visible", true);
      commands.set(slotPath + "Icon.Background", entry.iconPath);
      commands.set(slotPath + "Quantity.Text", entry.quantity > 1 ? Integer.toString(entry.quantity) : "");
    }
  }

  private void bindSlotEvents(UIEventBuilder events) {
    for (int i = 0; i < SLOT_COUNT; i++) {
      String slotPath = "#Slot" + i + "Button";
      events.addEventBinding(
          CustomUIEventBindingType.Activating,
          slotPath,
          EventData.of("Action", "stealStack").append("SlotIndex", Integer.toString(i)),
          false);
      events.addEventBinding(
          CustomUIEventBindingType.RightClicking,
          slotPath,
          EventData.of("Action", "stealOne").append("SlotIndex", Integer.toString(i)),
          false);
    }
  }

  private List<VisibleEntry> buildVisibleEntries() {
    return storagePage.getVisibleEntries().stream()
        .map(this::toVisibleEntry)
        .filter(entry -> entry != null)
        .limit(SLOT_COUNT)
        .toList();
  }

  private VisibleEntry toVisibleEntry(String entry) {
    ParsedEntry parsed = parseEntry(entry);
    if (parsed.itemId.isBlank() || parsed.quantity <= 0) {
      return null;
    }

    String iconPath = UNKNOWN_ICON;
    try {
      String resolved = storagePage.resolveItemIcon(parsed.itemId);
      if (resolved != null && !resolved.isBlank()) {
        iconPath = resolved;
      }
    } catch (Exception ignored) {
      iconPath = UNKNOWN_ICON;
    }

    return new VisibleEntry(parsed.itemId, parsed.quantity, iconPath);
  }

  private ParsedEntry parseEntry(String entry) {
    if (entry == null || entry.isBlank()) {
      return new ParsedEntry("", 0);
    }

    String[] parts = entry.split(":", 2);
    if (parts.length != 2) {
      return new ParsedEntry("", 0);
    }

    try {
      return new ParsedEntry(parts[0], Integer.parseInt(parts[1]));
    } catch (NumberFormatException ignored) {
      return new ParsedEntry("", 0);
    }
  }

  private record ParsedEntry(String itemId, int quantity) {}

  private record VisibleEntry(String itemId, int quantity, String iconPath) {}
}
