      },
      "Instructions": [
        {
          "$Comment": "Standard detection component: listen for beacons and check for nearby hostiles",
          "Reference": "HyThiefStealth_Goblin_Miner_C1",
          "Modify": {
            "_ExportStates": [
              "Alerted",
              "Combat.Maybe",
              "Combat.Message",
              "Search"
            ],
            "ViewRange": {
              "Compute": "ViewRange"
            },
            "ViewSector": {
              "Compute": "ViewSector"
            },
            "HearingRange": {
              "Compute": "HearingRange"
            },
            "AbsoluteDetectionRange": {
              "Compute": "AbsoluteDetectionRange"
            },
            "AlertedRange": {
              "Compute": "AlertedRange"
            },
            "BeaconMessage": "Goblin_Attack",
            "Attitudes": [
              "Hostile",
              "Neutral"
            ]
          }
        },
        {
          "$Comment": "Start flavour behaviour timers",
          "Sensor": {
            "Type": "Any",
            "Once": true
          },
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Mine_Ready",
              "RestartValueRange": {
                "Compute": "MineFrequency"
              },
              "StartValueRange": {
                "Compute": "MineFrequency"
              }
            },
            {
              "Type": "TimerRestart",
              "Name": "Mine_Ready"
            },
            {
              "Type": "TimerStart",
              "Name": "Sleep_Ready",
              "RestartValueRange": {
                "Compute": "SleepFrequency"
              },
              "StartValueRange": {
                "Compute": "SleepFrequency"
              }
            },
            {
              "Type": "TimerRestart",
              "Name": "Sleep_Ready"
            }
          ]
        },
        {
          "$Comment": "Mine a block if there's one nearby and the timeout is over",
          "Sensor": {
            "Type": "Timer",
            "Name": "Mine_Ready",
            "State": "Stopped"
          },
          "Instructions": [
            {
              "$Comment": "If a nearby block is found, go mine it",
              "Sensor": {
                "Type": "Block",
                "Blocks": {
                  "Compute": "MineBlockset"
                },
                "Range": {
                  "Compute": "ViewRange"
                }
              },
              "Actions": [
                {
                  "Type": "StorePosition",
                  "Slot": "MineBlock"
                },
                {
                  "Type": "State",
                  "State": "IdleMine.Seek"
                }
              ]
            },
            {
              "$Comment": "If a nearby block is found, go mine it. Search at a slight downward angle to avoid weird pathfinding to wall blocks",
              "Sensor": {
                "Type": "SearchRay",
                "Name": "MineRay",
                "Angle": 10,
                "Blocks": {
                  "Compute": "MineBlocksetRay"
                },
                "Range": {
                  "Compute": "ViewRange"
                }
              },
              "Actions": [
                {
                  "Type": "StorePosition",
                  "Slot": "MineBlock"
                },
                {
                  "Type": "State",
                  "State": "IdleMine.Seek"
                }
              ]
            },
            {
              "$Comment": "If no blocks are found, restart timer to avoid constant Block sensor checks",
              "Actions": [
                {
                  "Type": "TimerRestart",
                  "Name": "Mine_Ready"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Go to sleep after the timeout is over",
          "Sensor": {
            "Type": "Timer",
            "Name": "Sleep_Ready",
            "State": "Stopped"
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "State",
              "State": "IdleSleep"
            }
          ]
        },
        {
          "$Comment": "Detect dropped food items",
          "Sensor": {
            "Type": "DroppedItem",
            "Items": {
              "Compute": "FoodItems"
            },
            "LineOfSight": true,
            "Range": {
              "Compute": "ViewRange"
            }
          },
          "Actions": [
            {
              "Type": "State",
              "State": "IdleEat"
            }
          ]
        },
        {
          "$Comment": "Idle behaviors",
          "Reference": "HyThiefStealth_Goblin_Miner_C4",
          "Modify": {
            "_ExportStates": [
              "IdleEat",
              "Idle"
            ],
            "WeightWalk": {
              "Compute": "IdleWalkWeight"
            },
            "WeightRun": {
              "Compute": "IdleRunWeight"
            },
            "WeightAnimation": {
              "Compute": "IdleAnimationWeight"
