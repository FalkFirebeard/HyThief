{
  "Type": "Component",
  "Class": "Instruction",
  "Parameters": {
    "WanderRadius": {
      "Description": "The max range within which the NPC will wander",
      "TypeHint": "Double",
      "Value": 15
    },
    "_ImportStates": [
      "State1",
      "State2"
    ],
    "WeightWalk": {
      "Description": "Parameter WeightWalk",
      "TypeHint": "Double",
      "Value": 20
    },
    "WeightRun": {
      "Description": "Parameter WeightRun",
      "TypeHint": "Double",
      "Value": 20
    },
    "WeightAnimation": {
      "Description": "Parameter WeightAnimation",
      "TypeHint": "Double",
      "Value": 10
    },
    "WeightState1": {
      "Description": "Parameter WeightState",
      "TypeHint": "String",
      "Value": 0
    },
    "WeightState2": {
      "Description": "Parameter WeightState2",
      "TypeHint": "Double",
      "Value": 0
    }
  },
  "Content": {
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "Idle behaviours",
        "Type": "Random",
        "Name": "Goblin_Random_Idles",
        "ExecuteFor": [
          15,
          20
        ],
        "Instructions": [
          {
            "$Comment": "Walk around",
            "Enabled": {
              "Compute": "WeightWalk > 0"
            },
            "Weight": {
              "Compute": "WeightWalk"
            },
            "BodyMotion": {
              "Type": "Sequence",
              "Looped": true,
              "Motions": [
                {
                  "Type": "Timer",
                  "Time": [
                    4,
                    8
                  ],
                  "Motion": {
                    "Type": "WanderInCircle",
                    "Radius": {
                      "Compute": "WanderRadius"
                    }
                  }
                },
                {
                  "Type": "Timer",
                  "Time": [
                    2,
                    4
                  ],
                  "Motion": {
                    "Type": "Nothing"
                  }
                }
              ]
            }
          },
          {
            "$Comment": "Run around",
            "Enabled": {
              "Compute": "WeightRun > 0"
            },
            "Weight": {
              "Compute": "WeightRun"
            },
            "BodyMotion": {
              "Type": "Sequence",
              "Looped": true,
              "Motions": [
                {
                  "Type": "Timer",
                  "Time": [
                    4,
                    6
                  ],
                  "Motion": {
                    "Type": "WanderInCircle",
                    "MaxHeadingChange": 20,
                    "Radius": {
                      "Compute": "WanderRadius"
                    },
                    "RelativeSpeed": 1
                  }
                },
                {
                  "Type": "Timer",
                  "Time": [
                    1,
                    3
                  ],
                  "Motion": {
                    "Type": "Nothing"
                  }
                }
              ]
            }
          },
          {
            "$Comment": "Stop and play a random animation",
            "Enabled": {
              "Compute": "WeightAnimation > 0"
            },
            "Weight": {
              "Compute": "WeightAnimation"
            },
            "BodyMotion": {
              "Type": "Nothing"
            },
            "ActionsBlocking": true,
            "Actions": [
              {
                "Type": "Timeout",
                "Delay": [
                  1,
                  3
                ]
              },
              {
                "Type": "Random",
                "Actions": [
                  {
                    "Action": {
                      "Type": "PlayAnimation",
                      "Slot": "Status",
                      "Animation": "Yawn"
                    },
                    "Weight": 1
                  },
                  {
                    "Action": {
                      "Type": "PlayAnimation",
                      "Slot": "Status",
                      "Animation": "ScratchButt"
                    },
                    "Weight": 1
                  },
                  {
                    "Action": {
                      "Type": "PlayAnimation",
                      "Slot": "Status",
                      "Animation": "KickGround"
                    },
                    "Weight": 1
                  }
                ]
              },
              {
                "Type": "Timeout",
                "Delay": [
                  3,
                  4
                ]
              },
              {
                "Type": "ResetInstructions",
                "Instructions": [
                  "Goblin_Random_Idles"
                ]
              }
            ]
          },
          {
            "$Comment": "Go to a custom flavor state",
            "Enabled": {
              "Compute": "WeightState1 > 0"
            },
            "Weight": {
              "Compute": "WeightState1"
            },
            "Actions": [
              {
                "Type": "ParentState",
                "State": "State1"
              }
            ]
          },
          {
            "$Comment": "Go to a custom flavor state",
            "Enabled": {
              "Compute": "WeightState2 > 0"
            },
            "Weight": {
              "Compute": "WeightState2"
            },
            "Actions": [
              {
                "Type": "ParentState",
                "State": "State2"
              }
            ]
          }
        ]
      }
    ]
  }
}
