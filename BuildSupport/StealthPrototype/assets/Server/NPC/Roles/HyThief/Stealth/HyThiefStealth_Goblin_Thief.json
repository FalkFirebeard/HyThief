  "Instructions": [
    {
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "$Comment": "Start the dig timer",
          "Sensor": {
            "Type": "Any",
            "Once": true
          },
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Timer_Dig",
              "RestartValueRange": {
                "Compute": "DigFrequency"
              },
              "StartValueRange": {
                "Compute": "DigFrequency"
              }
            },
            {
              "Type": "TimerRestart",
              "Name": "Timer_Dig"
            }
          ]
        },
        {
          "$Comment": "Standard detection component: listen for beacons and check for nearby hostiles",
          "Reference": "HyThiefStealth_Goblin_Thief_C1",
          "Modify": {
            "_ExportStates": [
              "Alerted",
              "Flee",
              "Flee",
              "Search"
            ],
            "ViewRange": {
              "Compute": "ViewRange"
            },
            "ViewSector": {
              "Compute": "ViewSector"
            },
            "HearingRange": {
              "Compute": "HearingRange"
            },
            "AbsoluteDetectionRange": {
              "Compute": "AbsoluteDetectionRange"
            },
            "AlertedRange": {
              "Compute": "AlertedRange"
            },
            "BeaconMessage": "Goblin_Attack",
            "Attitudes": [
              "Hostile",
              "Neutral"
            ]
          }
        },
        {
          "$Comment": "Dig up nearby blocks to look for treasure",
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Block",
                "Blocks": {
                  "Compute": "DigBlockset"
                },
                "Range": {
                  "Compute": "ViewRange"
                },
                "Reserve": true
              },
              {
                "Type": "Timer",
                "Name": "Timer_Dig",
                "State": "Stopped"
              }
            ]
          },
          "Actions": [
            {
              "Type": "StorePosition",
              "Slot": "Dig_TargetPos"
            },
            {
              "Type": "State",
              "State": "IdleDig"
            }
          ]
        },
        {
          "$Comment": "Idle behaviors",
          "Reference": "HyThiefStealth_Goblin_Thief_C4",
          "Modify": {
            "_ExportStates": [
              "Idle",
              "Idle"
            ],
            "WeightWalk": {
              "Compute": "IdleWalkWeight"
            },
            "WeightRun": {
              "Compute": "IdleRunWeight"
            },
            "WeightAnimation": {
              "Compute": "IdleAnimationWeight"
            },
            "WanderRadius": {
              "Compute": "WanderRadius"
            }
          }
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "IdleDig"
      },
      "Instructions": [
        {
          "$Comment": "Standard detection component: listen for beacons and check for nearby hostiles",
          "Reference": "Component_Instruction_Generic_Detection",
          "Modify": {
            "_ExportStates": [
              "Alerted",
              "Flee",
              "Flee",
              "Search"
            ],
            "ViewRange": {
              "Compute": "ViewRange"
            },
            "ViewSector": {
              "Compute": "ViewSector"
            },
            "HearingRange": {
              "Compute": "HearingRange"
            },
            "AbsoluteDetectionRange": {
              "Compute": "AbsoluteDetectionRange"
            },
            "AlertedRange": {
              "Compute": "AlertedRange"
            },
            "BeaconMessage": "Goblin_Attack"
          }
        },
        {
          "$Comment": "Always look at the target block",
          "Continue": true,
          "Sensor": {
            "Type": "ReadPosition",
            "Range": {
              "Compute": "ViewRange"
            },
            "Slot": "Dig_TargetPos"
          },
          "HeadMotion": {
            "Type": "Watch"
          }
        },
        {
          "$Comment": "When close to the block, dig it",
          "Sensor": {
            "Type": "ReadPosition",
            "Range": 1.5,
            "Slot": "Dig_TargetPos"
          },
          "BodyMotion": {
            "Type": "Nothing"
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "Random",
              "Actions": [
                {
                  "Action": {
                    "Type": "PlayAnimation",
                    "Animation": "Dig",
                    "Slot": "Status"
                  },
                  "Weight": 1
                },
                {
                  "Action": {
                    "Type": "PlayAnimation",
                    "Animation": "DigFind",
                    "Slot": "Status"
                  },
                  "Weight": 1
                }
              ]
            },
            {
              "Type": "Timeout",
              "Delay": [
                4,
                7
              ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Timer_Dig"
            },
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        },
        {
          "$Comment": "Seek the block",
          "Sensor": {
            "Type": "ReadPosition",
            "Range": {
              "Compute": "ViewRange"
            },
            "Slot": "Dig_TargetPos"
          },
          "BodyMotion": {
            "Type": "Seek",
            "RelativeSpeed": 1,
            "SlowDownDistance": 2,
            "StopDistance": 0.5
          }
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Alerted"
      },
      "Instructions": [
        {
          "$Comment": "Play alerted animation",
          "Continue": true,
          "Sensor": {
            "Type": "Any",
            "Once": true
          },
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Slot": "Status",
              "Animation": "Alerted"
            }
          ]
        },
        {
          "$Comment": "Start fleeing if the target gets too close or the NPC is damaged",
          "Sensor": {
            "Type": "Or",
            "Sensors": [
              {
                "Type": "Damage"
              },
              {
                "Type": "Target",
                "Range": {
                  "Compute": "ViewRange * 0.5"
                },
                "Filters": [
                  {
                    "Type": "LineOfSight"
                  },
                  {
                    "Type": "ViewSector",
                    "ViewSector": {
                      "Compute": "ViewSector"
                    }
                  }
                ]
              }
            ]
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Flee"
            }
          ]
        },
        {
          "$Comment": "Always watch the target",
          "Sensor": {
            "Type": "Target",
            "Range": {
              "Compute": "AlertedRange"
            }
          },
          "HeadMotion": {
            "Type": "Watch"
          },
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": {
                "Compute": "AlertedTimeout"
              },
              "Action": {
                "Type": "State",
                "State": "Flee"
              }
            }
          ],
          "ActionsBlocking": true
        },
        {
          "$Comment": "No target, go back to idling",
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [
                2,
                2
              ],
              "Action": {
                "Type": "State",
                "State": "Idle"
              }
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Flee"
      },
      "Instructions": [
        {
          "Reference": "Component_Instruction_Combat_Target_Swap",
          "Modify": {
            "NextTargetRangeView": {
              "Compute": "ViewRange"
            },
            "NextTargetRangeHearing": {
              "Compute": "HearingRange"
            }
          }
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".Timeout"
          },
          "Instructions": [
            {
              "$Comment": "Watch the target when detected",
              "Continue": true,
              "Sensor": {
                "Reference": "Component_Sensor_Target_Sight_Or_Sound",
                "Modify": {
                  "HearingRange": {
                    "Compute": "HearingRange"
                  },
                  "ViewRange": {
                    "Compute": "ViewRange"
                  },
                  "ViewSector": {
                    "Compute": "ViewSector"
                  }
                }
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Target"
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                }
              ]
            },
            {
              "$Comment": "If the target gets too close again, resume fleeing",
              "Sensor": {
                "Type": "Target",
                "Filters": [
                  {
                    "Type": "LineOfSight"
                  },
                  {
                    "Type": "ViewSector",
                    "ViewSector": {
                      "Compute": "ViewSector"
                    }
                  }
                ],
                "Range": {
                  "Compute": "FleeDistance * 0.5"
                }
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status",
                  "Animation": "Alerted"
                },
                {
                  "Type": "Timeout",
                  "Delay": [
                    1,
                    2
                  ]
                },
                {
                  "Type": "State",
                  "State": ".Default"
                }
              ]
            },
            {
              "$Comment": "Timeout, do an animation and go back to idle",
              "Sensor": {
                "Type": "Target",
                "Filters": [
                  {
                    "Type": "LineOfSight"
                  }
                ]
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": {
                    "Compute": "FleeTimeoutDuration"
                  }
                },
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status",
                  "Animation": "Angry"
                },
                {
                  "Type": "Timeout",
                  "Delay": [
                    2,
                    2
                  ]
                },
                {
                  "Type": "State",
                  "State": "Idle"
                }
              ]
            },
            {
              "$Comment": "No target, back to idle",
              "Actions": [
                {
                  "Type": "Timeout"
                },
                {
                  "Type": "Timeout",
                  "Delay": [
                    1,
                    1
                  ],
                  "Action": {
                    "Type": "State",
                    "State": "Idle"
                  }
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".Fall"
          },
          "BodyMotion": {
            "Type": "Nothing"
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Slot": "Status",
              "Animation": "Death"
            },
            {
              "Type": "Timeout",
              "Delay": [
                0.5,
                0.5
              ]
            },
            {
              "Type": "DropItem",
              "DropList": {
                "Compute": "FleeTripDropList"
              },
              "Once": true,
              "ThrowSpeed": 10
            },
            {
              "Type": "SpawnParticles",
              "ParticleSystem": "Stunned",
              "TargetNodeName": "Head"
            },
            {
              "Type": "Timeout",
              "Delay": [
                1,
                1
              ]
            },
            {
              "Type": "PlayAnimation",
              "Slot": "Status"
            },
            {
              "Type": "State",
              "ClearState": false,
              "State": ".Default"
            }
          ]
        },
        {
          "$Comment": "Cower in fear while another Goblin engages the target",
          "Sensor": {
            "Type": "State",
            "State": ".Cower"
          },
          "Instructions": [
            {
              "$Comment": "If the NPC is damaged, go back to fleeing",
              "Sensor": {
                "Type": "Damage"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Default"
                }
              ]
            },
            {
              "$Comment": "If there are no Goblins that can help nearby, go back to fleeing",
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "Mob",
                  "Range": {
                    "Compute": "FleeCowerMaintainDistance * 2"
                  },
                  "Filters": [
                    {
                      "Type": "NPCGroup",
                      "IncludeGroups": {
                        "Compute": "FleeSeekGoblinGroups"
                      }
                    },
                    {
                      "Type": "LineOfSight"
                    }
                  ]
                }
              },
              "BodyMotion": {
                "Type": "Nothing"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "Random",
                  "Actions": [
                    {
                      "Action": {
                        "Type": "Sequence",
                        "Blocking": true,
                        "Actions": [
                          {
                            "Type": "PlayAnimation",
                            "Animation": "Scared",
                            "Slot": "Status"
                          },
                          {
                            "Type": "Timeout",
                            "Delay": [
                              1,
                              3
                            ]
                          },
                          {
                            "Type": "PlayAnimation",
                            "Slot": "Status"
                          }
                        ]
                      },
                      "Weight": 1
                    },
                    {
                      "Action": {
                        "Type": "Nothing"
                      },
                      "Weight": 1
                    }
                  ]
                },
                {
                  "Type": "State",
                  "State": ".Default"
                }
              ]
            },
            {
              "$Comment": "Watch the combat target",
              "Continue": true,
              "Sensor": {
                "Type": "Target",
                "Range": {
                  "Compute": "FleeDistance"
                },
                "Filters": [
                  {
                    "Type": "LineOfSight"
                  }
                ]
              },
              "BodyMotion": {
                "Type": "MaintainDistance",
                "DesiredDistanceRange": {
                  "Compute": "makeRange(FleeCowerMaintainDistance)"
                }
              },
              "HeadMotion": {
                "Type": "Watch"
              }
            },
            {
              "$Comment": "If the combat target leaves the flee distance, go back to idling",
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "Target",
                  "Range": {
                    "Compute": "FleeDistance"
                  },
                  "TargetSlot": "LockedTarget",
                  "Filters": []
                }
              },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Action": {
                    "Type": "State",
                    "State": "Idle"
                  }
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Periodically send an alert beacon to nearby friendlies",
          "Continue": true,
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": {
                "Compute": "CombatMessageFrequency"
              }
            },
            {
              "Type": "SpawnParticles",
              "ParticleSystem": "Alerted",
              "TargetNodeName": "Head"
            },
            {
              "Type": "Beacon",
              "Message": "Goblin_Attack",
              "Range": {
                "Compute": "AlertedRange"
              },
              "SendTargetSlot": "LockedTarget",
              "TargetGroups": {
                "Compute": "CombatMessageTargetGroups"
              }
            }
          ]
        },
        {
          "$Comment": "Periodically trip and fall, losing items in the process",
          "Continue": true,
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "MovementState",
                "State": "Running"
              }
            ]
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": {
                "Compute": "FleeTripFrequency"
              }
            },
            {
              "Type": "State",
              "State": ".Fall"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Instructions": [
            {
              "$Comment": "If there's a Goblin nearby, seek them",
              "Sensor": {
                "Type": "Mob",
                "MinRange": {
                  "Compute": "FleeSeekGoblinDistance * 0.25"
                },
                "Range": {
                  "Compute": "FleeSeekGoblinDistance"
                },
                "Filters": [
                  {
                    "Type": "NPCGroup",
                    "IncludeGroups": {
                      "Compute": "FleeSeekGoblinGroups"
                    }
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "SetMarkedTarget",
                  "TargetSlot": "SeekTarget"
                },
                {
                  "Type": "State",
                  "State": ".SeekGoblin"
                }
              ]
            },
            {
              "$Comment": "Flee from the target until it's beyond FleeDistance",
              "Sensor": {
                "Type": "Target",
                "Range": {
                  "Compute": "FleeDistance"
                }
              },
              "BodyMotion": {
                "Type": "Flee",
                "SlowDownDistance": {
